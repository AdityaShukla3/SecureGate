# ==============================================================================
# SecureGate API Gateway - Environment Configuration Example
# Copy this file to .env and provide your production or local secrets.
# ==============================================================================

# Server port (default: 8080)
PORT=8080

# PostgreSQL Connection String
DATABASE_URL=postgres://postgres:pass@localhost:5432/securegate

# Redis Connection String
REDIS_URL=redis://localhost:6379

# Cryptographic Secrets (Use strong random 32+ character strings in production)
JWT_SECRET=your-production-jwt-secret-min-32-chars-long
GATEWAY_SECRET=your-production-backend-shared-secret-min-32-chars

# Microservice Target URLs (Reverse Proxy Destinations)
LOGS_URL=http://localhost:4001
INVENTORY_URL=http://localhost:4002

# Rate Limiting (Allowed requests per minute per client IP)
RATE_LIMIT=100

# Proxy Trust (Set to 1 if behind Nginx, Cloudflare, AWS ALB, Render, or Railway)
TRUST_PROXY=1

# Google OAuth 2.0 (From Google Cloud Console -> Credentials -> OAuth Client ID)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Initial Seed Admin Password (Used by `npm run init` on first database setup)
ADMIN_PASSWORD=Admin@12345
