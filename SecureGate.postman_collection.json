{
  "info": {
    "name": "SecureGate API",
    "description": "Complete test suite for SecureGate API Security Gateway",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "viewerToken",
      "value": ""
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "refreshToken",
      "value": ""
    },
    {
      "key": "adminRefreshToken",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", function () { pm.expect([200]).to.include(pm.response.code); });"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Direct Backend Call (Should Fail 403)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:4002/",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "4002",
          "path": [
            ""
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 403\", function () { pm.expect([403]).to.include(pm.response.code); });"
            ]
          }
        }
      ]
    },
    {
      "name": "3. Register User (Viewer)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"user@securegate.dev\",\n  \"password\": \"Password123!\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "register"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 201 or 409\", function () { pm.expect([201, 409]).to.include(pm.response.code); });"
            ]
          }
        }
      ]
    },
    {
      "name": "4. Login as Viewer",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"user@securegate.dev\",\n  \"password\": \"Password123!\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", function () { pm.expect([200]).to.include(pm.response.code); });",
              "if (pm.response.code === 200) {",
              "  const b = pm.response.json();",
              "  pm.collectionVariables.set(\"viewerToken\", b.access);       // saved automatically",
              "  pm.collectionVariables.set(\"refreshToken\", b.refresh);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "5. Login as Admin",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@securegate.dev\",\n  \"password\": \"Admin@12345\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", function () { pm.expect([200]).to.include(pm.response.code); });",
              "if (pm.response.code === 200) {",
              "  const b = pm.response.json();",
              "  pm.collectionVariables.set(\"adminToken\", b.access);        // saved automatically",
              "  pm.collectionVariables.set(\"adminRefreshToken\", b.refresh);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "6. Access Proxied Inventory (Viewer Allowed - 200)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{viewerToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/inventory",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "inventory"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", function () { pm.expect([200]).to.include(pm.response.code); });"
            ]
          }
        }
      ]
    },
    {
      "name": "7. Access Proxied Logs (Viewer Forbidden - 403)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{viewerToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/logs",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "logs"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 403\", function () { pm.expect([403]).to.include(pm.response.code); });"
            ]
          }
        }
      ]
    },
    {
      "name": "8. Access Proxied Logs (Admin Allowed - 200)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/logs",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "logs"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", function () { pm.expect([200]).to.include(pm.response.code); });"
            ]
          }
        }
      ]
    },
    {
      "name": "9. View Audit Trail (Admin Only)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/admin/audit",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "admin",
            "audit"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", function () { pm.expect([200]).to.include(pm.response.code); });"
            ]
          }
        }
      ]
    },
    {
      "name": "10. Admin Block IP",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"ip\": \"192.168.1.50\",\n  \"reason\": \"Suspicious port scanning\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/admin/ips/block",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "admin",
            "ips",
            "block"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 201\", function () { pm.expect([201]).to.include(pm.response.code); });"
            ]
          }
        }
      ]
    },
    {
      "name": "11. Refresh Token Exchange",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/refresh",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "refresh"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", function () { pm.expect([200]).to.include(pm.response.code); });",
              "if (pm.response.code === 200) {",
              "  const b = pm.response.json();",
              "  // refresh tokens work only once, so save BOTH new tokens",
              "  pm.collectionVariables.set(\"viewerToken\", b.access);",
              "  pm.collectionVariables.set(\"refreshToken\", b.refresh);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "12. Logout (Revoke Token)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{viewerToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/logout",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "logout"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", function () { pm.expect([200]).to.include(pm.response.code); });"
            ]
          }
        }
      ]
    }
  ]
}