{
  "name": "securegate",
  "version": "1.0.0",
  "description": "SecureGate: Standalone reverse-proxy API security gateway",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "init": "node src/db/init.js",
    "svc:logs": "node services/dummy.js logs 4001",
    "svc:inv": "node services/dummy.js inventory 4002",
    "test": "jest --runInBand --forceExit"
